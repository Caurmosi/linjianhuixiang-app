# 《林间回响》后端环境变量（全部可选，均有默认值）
# 复制为 .env 或直接 export 后启动

# 识别引擎：auto（有模型用 BirdNET，否则启发式）/ birdnet / heuristic
LJX_BIRDSNET_MODE=auto

# 模型与标签路径（默认 backend/models/）
LJX_BIRDSNET_MODEL_PATH=models/BirdNET_GLOBAL_6K_V2.4_Model_FP16.tflite
LJX_BIRDSNET_LABELS_PATH=models/eBird_taxonomy_codes_V6.0.csv

# 置信度阈值（0.05-0.95，前端滑杆 0.30-0.90）
LJX_CONFIDENCE_THRESHOLD=0.5

# 数据目录 / 数据库
LJX_DATA_DIR=data
LJX_DB_PATH=data/linjianhuixiang.db

# 上传限制
LJX_MAX_UPLOAD_MB=30

# CORS（逗号分隔，* 表示全部）
LJX_CORS_ORIGINS=*
